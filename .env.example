# ==============================================================================
# GLM-5.2-Colibri-Google-Drive-Runtime Environment Configuration Template
# Copy this file to .env and populate with your credentials and local paths.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Google Drive Target Configuration
# Authenticated Account: aqibjawwad2607@gmail.com
GOOGLE_ACCOUNT=aqibjawwad2607@gmail.com
GOOGLE_DRIVE_FOLDER_ID=11BdZx7pI2XyEmiJjpZJjTCIX1V41vKhd
GOOGLE_DRIVE_FOLDER_NAME="AI - Google Drive"

# Hugging Face Authentication (Required for gated/private models; optional for public)
HF_TOKEN=hf_your_huggingface_access_token_here

# Model Repository Identifiers
# Primary (Recommended): mastouri/GLM-5.2-colibri-int4-g64-with-int8-mtp
# Video Reference: annelo/GLM-5.2-FP8-Uncensored-Colibri-Int4
# Legacy Fallback: jlnsrk/GLM-5.2-colibri-int4
MODEL_REPO=mastouri/GLM-5.2-colibri-int4-g64-with-int8-mtp
MODEL_REVISION=main

# Model Storage Paths
# Google Drive Persistent Directory (in Colab environment)
DRIVE_ROOT_DIR="/content/drive/MyDrive/AI - Google Drive"
DRIVE_PROJECT_DIR="/content/drive/MyDrive/AI - Google Drive/GLM-5.2"
DRIVE_MODEL_DIR="/content/drive/MyDrive/AI - Google Drive/GLM-5.2/model"
DRIVE_RUNTIME_DIR="/content/drive/MyDrive/AI - Google Drive/GLM-5.2/runtime"
DRIVE_LOGS_DIR="/content/drive/MyDrive/AI - Google Drive/GLM-5.2/logs"
DRIVE_MANIFESTS_DIR="/content/drive/MyDrive/AI - Google Drive/GLM-5.2/manifests"
DRIVE_BENCHMARKS_DIR="/content/drive/MyDrive/AI - Google Drive/GLM-5.2/benchmarks"

# Colab Local High-Speed NVMe Directory
LOCAL_MODEL_DIR=/content/model
# Active Model Directory used by the runtime (points to LOCAL_MODEL_DIR or DRIVE_MODEL_DIR)
MODEL_DIR=/content/model

# Colibrì Engine Runtime Configuration
COLI_ENGINE=c/colibri
COLI_MODEL_ID=glm-5.2-744b-moe-int4
COLI_MODEL=/content/model

# Networking & Serving Configuration
COLI_HOST=127.0.0.1
COLI_PORT=8000
COLI_API_KEY=coli_sk_live_replace_with_secure_random_key

# Generation & Queue Constraints
COLI_MAX_TOKENS=4096
COLI_MAX_QUEUE=32
COLI_QUEUE_TIMEOUT=120
COLI_TEMPERATURE=0.7
COLI_TOP_P=0.9

# Dual-SSD Mirror Configuration (Optional for hybrid NVMe + Drive staging)
# COLI_MODEL_MIRROR="/content/drive/MyDrive/AI - Google Drive/GLM-5.2/model"
# COLI_DISK_WEIGHTS=9,1
